<mujoco>
      <asset>
        <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3" rgb2=".2 .3 .4"
                    width="512" height="512"/>
        <texture name="grid2" type="2d" builtin="checker" rgb1=".1 .1 .1" rgb2=".5 .6 .7"
                    width="231" height="231"/>
        <material name="grid" texture="grid" texrepeat="2 2" texuniform="true" reflectance=".2"/>
        <material name="grid2" texture="grid2" texrepeat="2 2" texuniform="true"/>
        <material name="frame" rgba="0.8 0.6 0.4 1"/>
    </asset>

    <worldbody>
        <light pos=".3 -.3 .8" diffuse="1 1 1" specular=".3 .3 .3"/>
        <geom name="floor" type="plane" size="3 3 .01" pos="-0.025 -0.295  0" material="grid"/>
        <camera name="top" pos="-0.37 -0.78 0.49" xyaxes="0.78 -0.63 0 0.27 0.33 0.9"/>

        <body name="wheel1" >
            <freejoint/>
            <geom name="wheel" type="ellipsoid" size=".37 .03 .37" pos="0 0 .37" material="grid2"/>

        </body>



    </worldbody>
</mujoco>



